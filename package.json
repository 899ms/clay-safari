{
  "name": "clay-safari",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5290",
    "build": "vite build",
    "deploy": "npm run build && npx wrangler@4.114.0 deploy",
    "preview": "vite preview --port 5291",
    "models": "${BLENDER:-blender} -b -P blender/build_animals.py -- public/models"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "vite": "^8.2.2"
  },
  "description": "Clay-style 3D bilingual animal world — Blender-scripted GLB animals + Three.js, with synthesized sounds and TTS",
  "license": "MIT",
  "keywords": [
    "three.js",
    "blender",
    "claymation",
    "3d",
    "education",
    "bilingual",
    "kids",
    "vite",
    "web-audio"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
